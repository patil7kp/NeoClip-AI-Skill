{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clip_history.schema.json",
  "title": "Clip history for one source video",
  "description": "Stored at <state_dir>/history/<video_id>.json. Never inside output folders.",
  "type": "object",
  "required": ["schema_version", "video_id", "clips", "used_segments"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "video_id": {"type": "string", "pattern": "^(yt-[A-Za-z0-9_-]{11}|local-[0-9a-f]{16})$"},
    "source_kind": {"enum": ["youtube", "local"]},
    "url": {"type": ["string", "null"]},
    "title": {"type": ["string", "null"]},
    "creator": {"type": ["string", "null"]},
    "channel_url": {"type": ["string", "null"]},
    "duration": {"type": ["number", "null"], "minimum": 0},
    "local_paths": {"type": "array", "items": {"type": "string"}},
    "first_processed": {"type": "string"},
    "last_updated": {"type": "string"},
    "templates_used": {"type": "array", "items": {"type": "string"}},
    "caption_preset": {"type": ["string", "null"]},
    "clips": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["clip_id", "start", "end", "template", "status", "processing_date"],
        "properties": {
          "clip_id": {"type": "string"},
          "job_id": {"type": "string"},
          "start": {"type": "number", "minimum": 0},
          "end": {"type": "number", "minimum": 0},
          "label": {"type": "string"},
          "template": {"type": "string"},
          "status": {"enum": ["reserved", "rendering", "completed", "failed", "interrupted", "skipped"]},
          "filename": {"type": ["string", "null"]},
          "output_path": {"type": ["string", "null"]},
          "processing_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "created_at": {"type": "string"},
          "updated_at": {"type": "string"},
          "completed_at": {"type": "string"},
          "overlap_reason": {"type": ["string", "null"]},
          "error": {"type": ["string", "null"]},
          "attempts": {"type": "integer"},
          "title": {"type": "string"},
          "output_duration": {"type": "number"},
          "risk": {"enum": ["low", "medium", "high"]}
        }
      }
    },
    "used_segments": {"type": "array", "items": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}},
    "unused_segments": {"type": "array", "items": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}}
  }
}
