{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plan.schema.json",
  "title": "Agent-written render plan (cli.py render --plan plan.json)",
  "type": "object",
  "required": ["input", "rights", "clips"],
  "properties": {
    "input": {"type": "string", "description": "YouTube URL or local path"},
    "rights": {"enum": ["own", "permission", "licensed", "creative-commons", "public-domain"]},
    "template": {"type": "string"},
    "resolution": {"type": "string", "pattern": "^\\d+x\\d+$"},
    "output_root": {"type": "string"},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "caption_preset": {"enum": ["bold_pop", "clean_pro", "story", "minimal"]},
    "captions": {"type": "boolean"},
    "subtitles": {"type": "string"},
    "creator": {"type": "string"},
    "channel_url": {"type": "string"},
    "source_url": {"type": "string"},
    "clips": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["start", "end"],
        "properties": {
          "start": {"type": ["number", "string"]},
          "end": {"type": ["number", "string"]},
          "slug": {"type": "string", "description": "2-4 words, becomes NN_slug.mp4"},
          "heading": {"type": "string"},
          "title": {"type": "string", "maxLength": 100},
          "description": {"type": "string", "maxLength": 4000},
          "hashtags": {"type": "array", "items": {"type": "string"}, "maxItems": 8},
          "hook_text": {"type": "string", "maxLength": 60},
          "overlap_reason": {"type": "string"},
          "music": {"enum": ["off", "auto", "always"]},
          "music_track": {"type": "string"},
          "mood": {"type": "string"},
          "has_commentary": {"type": "boolean"}
        }
      }
    }
  }
}
